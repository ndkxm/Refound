# Biến môi trường của server khi chạy trên máy local. Copy thành server/.env rồi điền giá trị thật. KHÔNG commit .env.
# Spring tự đọc file này khi chạy trong thư mục server/ (spring.config.import trong application.yml).
# Trên Render không dùng file này: đặt các biến ở mục Environment (docs/setup.md).
# Định dạng .properties: KEY=giá trị, không đặt dấu ngoặc kép.

# Supabase: Connect → Session pooler (cổng 5432). User có dạng postgres.<project-ref>.
DATABASE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?currentSchema=refound,extensions&sslmode=require
DATABASE_USERNAME=postgres.<project-ref>
DATABASE_PASSWORD=

# Supabase Storage: Project Settings → API Keys. Khóa secret (sb_secret_…) chỉ nằm ở server.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=item-images

# Firebase: project_id trong google-services.json (không bí mật), dùng kiểm iss/aud của ID token.
FIREBASE_PROJECT_ID=

# JWT của server (HS256): chuỗi ngẫu nhiên >= 32 byte, máy local và Render dùng chuỗi khác nhau. Hạn 7 ngày (ADR-05).
JWT_SECRET=
JWT_EXPIRATION_MS=604800000

# Gemini API (Google AI Studio), docs/setup.md
GEMINI_API_KEY=
# Đổi model embedding phải embed lại toàn bộ (ADR-02).
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Groq (mô tả ảnh), docs/setup.md
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
