# Copy file này thành .env rồi điền giá trị thật. Không commit .env.
#
# Chỉ biến có tiền tố EXPO_PUBLIC_ được đưa vào app, và ai có file APK cũng đọc được.
# KHÔNG BAO GIỜ đặt key AI, khóa Supabase hay mật khẩu database ở đây.
# Bí mật của server (Groq, Supabase, JWT) nằm trong biến môi trường của server, xem docs/setup.md.

# Địa chỉ server Spring: máy local (điện thoại thật cần IP LAN của máy tính) hoặc địa chỉ trên Render.
EXPO_PUBLIC_API_URL=http://<ip-may-tinh>:8080

# Web client ID của Google (OAuth client loại 3 trong google-services.json, mục oauth_client).
# Không phải bí mật. Thiếu thì Google không trả idToken và đăng nhập lỗi.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<so>-<chuoi>.apps.googleusercontent.com
