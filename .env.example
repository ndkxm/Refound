# Copy file này thành .env rồi điền giá trị thật. Không commit .env.
#
# Chỉ biến có tiền tố EXPO_PUBLIC_ được đưa vào app, và ai có file APK cũng đọc được.
# KHÔNG BAO GIỜ đặt service role key, mật khẩu database hay key AI ở đây.
# Key AI nằm trong supabase/functions/.env (xem supabase/functions/.env.example).

# Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon hoặc publishable key>
